{
  "apiVersion": "1.0",
  "id": "somfy-connectivity-kit-addon",
  "name": "Somfy Connectivity Kit (1870755) Integration",
  "version": "1.0.0",
  "type": "node",
  "executable": "dist/index.js",
  "main": "dist/index.js",
  "entryPoint": "dist/index.js",
  "description": "Integration für Somfy 1870755 Connectivity Kit: Bindet Somfy Rollläden, Fenster und Markisen als virtuelle Geräte in Busch-Jaeger free@home ein.",
  "author": "Stefan Seyerl",
  "webUi": {
    "port": 8080,
    "path": "/"
  },
  "virtualDevices": [
    {
      "type": "BlindActuator",
      "description": "Somfy Rollladen / Markise"
    },
    {
      "type": "WindowSensor",
      "description": "Somfy Fenster"
    }
  ],
  "permissions": [
    "virtualDeviceManagement",
    "network"
  ]
}
